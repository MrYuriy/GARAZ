# Copy to .env and fill in. Never commit .env.

# ----- app -----
APP_NAME=GARAZ
# Anything but "local" (e.g. production) refuses to start on placeholder JWT secrets.
ENV=local
DEBUG=true
HOST=0.0.0.0
# The server already runs other projects: pick a free port there (e.g. 8010).
PORT=8000
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:8000"]
TIMEZONE=Europe/Warsaw

# ----- android app links (truck QR codes open the installed app) -----
ANDROID_PACKAGE_NAME=pl.garaz.garaz_app
# SHA-256 of every signing certificate, comma-separated. Empty = no assetlinks.json.
ANDROID_SHA256_FINGERPRINTS=

# ----- uploaded files -----
# Inside the container; docker-compose mounts the `filestore` volume there.
STORAGE_DIR=/app/storage
MAX_DOCUMENT_MB=15

# ----- permits -----
# Daily pass that marks permits past their date as Wygasłe (local time, TIMEZONE).
PERMIT_EXPIRY_ENABLED=true
PERMIT_EXPIRY_HOUR=0
PERMIT_EXPIRY_MINUTE=5

# ----- postgres -----
POSTGRES_USER=garaz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=garaz
DATABASE_URL=postgresql://garaz:change-me@db:5432/garaz?sslmode=disable

# ----- redis (rate limiting) -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me
# Needs Redis. Off locally and in tests; on wherever the app faces the internet.
RATE_LIMIT_ENABLED=false

# ----- jwt -----
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET_KEY=change-me-access
JWT_REFRESH_SECRET_KEY=change-me-refresh
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# ----- first administrator (created on start when no SUPER_ADMIN exists) -----
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=
